{
  "manifest_version": 3,
  "name": "net19",
  "version": "0.3.0",
  "description": "Websites as they looked in 2019.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "cookies"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.wikipedia.org/*",
    "*://*.reddit.com/*",
    "*://*.github.com/*",
    "*://*.yahoo.com/*",
    "*://*.twitch.tv/*",
    "*://*.amazon.com/*",
    "*://*.ebay.com/*",
    "*://*.bing.com/*",
    "*://*.stackoverflow.com/*",
    "*://*.cnn.com/*",
    "*://*.nytimes.com/*",
    "*://*.imdb.com/*",
    "*://*.espn.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "net19",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-src 'none'"
  }
}
