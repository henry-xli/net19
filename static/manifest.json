{
  "manifest_version": 3,
  "name": "net19",
  "version": "0.4.0",
  "description": "Websites as they looked in 2019.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "cookies"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.wikipedia.org/*",
    "*://*.reddit.com/*",
    "*://*.github.com/*",
    "*://*.yahoo.com/*",
    "*://*.twitch.tv/*",
    "*://*.amazon.com/*",
    "*://*.ebay.com/*",
    "*://*.bing.com/*",
    "*://*.stackoverflow.com/*",
    "*://*.cnn.com/*",
    "*://*.nytimes.com/*",
    "*://*.imdb.com/*",
    "*://*.espn.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.linkedin.com/*",
    "*://*.yelp.com/*",
    "*://*.pinterest.com/*",
    "*://*.apple.com/*",
    "*://*.fandom.com/*",
    "*://*.tiktok.com/*",
    "*://*.merriam-webster.com/*",
    "*://*.walmart.com/*",
    "*://*.tripadvisor.com/*",
    "*://*.weather.com/*",
    "*://*.spotify.com/*",
    "*://*.indeed.com/*",
    "*://*.nih.gov/*",
    "*://*.clevelandclinic.org/*",
    "*://*.accuweather.com/*",
    "*://*.zillow.com/*",
    "*://*.quora.com/*",
    "*://*.britannica.com/*",
    "*://*.homedepot.com/*",
    "*://*.ny.gov/*",
    "*://*.microsoft.com/*",
    "*://*.mapquest.com/*",
    "*://*.target.com/*",
    "*://*.cambridge.org/*",
    "*://*.mayoclinic.org/*",
    "*://*.netflix.com/*",
    "*://*.foxnews.com/*",
    "*://*.adobe.com/*",
    "*://*.rottentomatoes.com/*",
    "*://*.usps.com/*",
    "*://*.timeanddate.com/*",
    "*://*.allrecipes.com/*",
    "*://*.etsy.com/*",
    "*://*.dictionary.com/*",
    "*://*.fedex.com/*",
    "*://*.lowes.com/*",
    "*://*.wunderground.com/*",
    "*://*.costco.com/*",
    "*://*.weather.gov/*",
    "*://*.craigslist.org/*",
    "*://*.trustpilot.com/*",
    "*://*.canva.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.genius.com/*",
    "*://*.gettyimages.com/*",
    "*://*.realtor.com/*",
    "*://*.nyc.gov/*",
    "*://*.expedia.com/*",
    "*://*.shutterstock.com/*",
    "*://*.nfl.com/*",
    "*://*.collinsdictionary.com/*",
    "*://*.mlb.com/*",
    "*://*.ubereats.com/*",
    "*://*.bbc.com/*",
    "*://*.bbc.co.uk/*",
    "*://*.healthline.com/*",
    "*://*.kbb.com/*",
    "*://*.stanford.edu/*",
    "*://*.cvs.com/*",
    "*://*.bestbuy.com/*",
    "*://*.oanda.com/*",
    "*://*.uga.edu/*",
    "*://*.nypost.com/*",
    "*://*.aa.com/*",
    "*://*.blog.youtube/*",
    "*://*.openai.com/*",
    "*://*.walgreens.com/*",
    "*://*.go.com/*",
    "*://*.abcnews.com/*",
    "*://*.abc.com/*",
    "*://*.usnews.com/*",
    "*://*.ca.gov/*",
    "*://*.booking.com/*",
    "*://*.istockphoto.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "net19",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-src 'none'"
  }
}
